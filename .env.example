# Copie este archivo a .env (o ejecute scripts/generar_env.sh) y complete los valores.
# El archivo .env no se versiona (ver .gitignore).
COMPOSE_PROJECT_NAME=atlas
PORT_POSTGRES=15432
PORT_BACKEND=4450
PORT_FRONTEND=3350

POSTGRES_USER=postgres
POSTGRES_DB=atlas
# Contraseña del administrador de PostgreSQL (mínimo 24 caracteres aleatorios)
POSTGRES_PASSWORD=
# Secreto de firma de los tokens JWT (mínimo 32 caracteres aleatorios)
JWT_SECRET=
